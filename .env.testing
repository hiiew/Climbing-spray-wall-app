APP_NAME="SprayWall Test"
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ── Database (overridden by CI secrets / env vars) ─────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=spraywall_test
DB_USERNAME=root
DB_PASSWORD=root

# ── Cache / Session / Queue ────────────────────────────────────────────────
CACHE_DRIVER=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync  # Synchronous in tests — no Horizon needed

# ── Broadcasting ───────────────────────────────────────────────────────────
BROADCAST_DRIVER=null  # Disable Pusher in tests

# ── Filesystem ────────────────────────────────────────────────────────────
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=fake-key
AWS_SECRET_ACCESS_KEY=fake-secret
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=test-bucket

# ── CV Microservice ────────────────────────────────────────────────────────
CV_SERVICE_URL=http://localhost:8001
CV_SERVICE_TIMEOUT=30
CV_SERVICE_API_KEY=test-cv-key

# ── Sanctum ───────────────────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

# ── Mail ──────────────────────────────────────────────────────────────────
MAIL_MAILER=array
